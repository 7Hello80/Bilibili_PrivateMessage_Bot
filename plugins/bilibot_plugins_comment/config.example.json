        "interval_minutes": 10,
        "max_per_run": 2,
        "dry_run": true,
        "skip_up_replied": true,
        "style": "友好",
        "extra_prompt": ""
    },
    "default_type": 1,
    "default_target": "",
    "accounts_index": 0
}
